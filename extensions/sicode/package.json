{
	"name": "sicode",
	"displayName": "SI Code",
	"description": "Bring-your-own-key chat, inline edit, and completions for SI Code.",
	"version": "1.0.0",
	"publisher": "sicode",
	"license": "MIT",
	"engines": {
		"vscode": "^1.95.0"
	},
	"enabledApiProposals": [
		"chatProvider",
		"chatParticipantAdditions",
		"defaultChatParticipant",
		"languageModelSystem"
	],
	"activationEvents": [
		"onStartupFinished",
		"onCommand:sicode.configure",
		"onCommand:sicode.freeModels",
		"onCommand:sicode.inlineEdit",
		"onCommand:sicode.openMcp",
		"onCommand:sicode.runPython",
		"onCommand:sicode.mcp.add",
		"onCommand:sicode.signIn",
		"onCommand:sicode.signOut"
	],
	"main": "./out/extension",
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": false
		}
	},
	"contributes": {
		"commands": [
			{
				"command": "sicode.configure",
				"title": "Configure AI",
				"category": "SI Code"
			},
			{
				"command": "sicode.freeModels",
				"title": "Get Free API Keys",
				"category": "SI Code"
			},
			{
				"command": "sicode.inlineEdit",
				"title": "Inline Edit",
				"category": "SI Code"
			},
			{
				"command": "sicode.openMcp",
				"title": "Open MCP Configuration",
				"category": "SI Code"
			},
			{
				"command": "sicode.runPython",
				"title": "Run Python File",
				"category": "SI Code"
			},
			{
				"command": "sicode.mcp.add",
				"title": "Add MCP Server",
				"category": "SI Code"
			},
			{
				"command": "sicode.mcp.browse",
				"title": "Browse MCP Servers",
				"category": "SI Code"
			},
			{
				"command": "sicode.mcp.installed",
				"title": "Show Installed MCP Servers",
				"category": "SI Code"
			},
			{
				"command": "sicode.mcp.connect",
				"title": "Connect MCP Servers",
				"category": "SI Code"
			},
			{
				"command": "sicode.signIn",
				"title": "Account",
				"category": "SI Code"
			},
			{
				"command": "sicode.signOut",
				"title": "Sign out",
				"category": "SI Code"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "sicode.inlineEdit",
					"when": "editorHasSelection && !editorReadonly",
					"group": "1_modification"
				},
				{
					"command": "sicode.runPython",
					"when": "editorLangId == python",
					"group": "navigation"
				}
			],
			"editor/title": [
				{
					"command": "sicode.runPython",
					"when": "editorLangId == python",
					"group": "navigation"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "sicode",
					"title": "SI Code",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"sicode": [
				{
					"type": "webview",
					"id": "sicode.mcp",
					"name": "MCP Servers"
				}
			]
		},
		"configuration": {
			"title": "SI Code",
			"properties": {
				"sicode.openai.model": {
					"type": "string",
					"default": "gpt-4o-mini",
					"description": "Model id sent to OpenAI."
				},
				"sicode.anthropic.model": {
					"type": "string",
					"default": "claude-sonnet-4-5",
					"description": "Model id sent to Anthropic."
				},
				"sicode.gemini.model": {
					"type": "string",
					"default": "gemini-2.0-flash",
					"description": "Model id sent to Google Gemini."
				},
				"sicode.sarvam.model": {
					"type": "string",
					"default": "sarvam-105b",
					"description": "Model id sent to Sarvam. The chat model is sarvam-105b. sarvam-105b-conversations is available for dialogue."
				},
				"sicode.openrouter.model": {
					"type": "string",
					"default": "openai/gpt-4o-mini",
					"description": "Model id sent to OpenRouter."
				},
				"sicode.compatible.model": {
					"type": "string",
					"default": "llama3.2",
					"description": "Model id sent to an OpenAI-compatible server, such as Ollama."
				},
				"sicode.compatible.baseUrl": {
					"type": "string",
					"default": "http://127.0.0.1:11434/v1",
					"description": "Base URL for the OpenAI-compatible server. Ollama's default is http://127.0.0.1:11434/v1."
				},
				"sicode.completions.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Offer inline completions from the first configured SI Code model."
				}
			}
		},
		"languageModelChatProviders": [
			{
				"vendor": "sicode-openai",
				"displayName": "OpenAI",
				"configuration": {
					"type": "object",
					"properties": {
						"endpoint": {
							"type": "string",
							"title": "Endpoint",
							"description": "Base URL for the provider. SI Code fills this in for known providers.",
							"default": "https://api.openai.com/v1"
						},
						"apiKey": {
							"type": "string",
							"secret": true,
							"title": "API Key",
							"description": "API key. Stored in secret storage."
						},
						"model": {
							"type": "string",
							"title": "Model",
							"description": "Model id sent to the provider. The list is refreshed from the provider when it publishes one.",
							"default": "gpt-4o-mini",
							"enum": [
								"gpt-4o-mini",
								"gpt-4o",
								"gpt-4.1-mini",
								"gpt-4.1",
								"o4-mini",
								"o3-mini"
							],
							"enumItemLabels": [
								"GPT-4o mini",
								"GPT-4o",
								"GPT-4.1 mini",
								"GPT-4.1",
								"o4-mini",
								"o3-mini"
							],
							"modelList": "openai",
							"allowCustomValue": true
						}
					},
					"required": [
						"endpoint",
						"apiKey",
						"model"
					]
				}
			},
